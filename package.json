{
  "name": "nolizi-web",
  "version": "0.1.0",
  "description": "The Nolizi website.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/build.js",
    "clean": "rm -rf dist site .build",
    "serve": "node dist/serve.js",
    "dev": "npm run build && npm run serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "rm -rf .build && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test test/site.test.js"
  },
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "homepage": "https://nolizi.com"
}
